# =====================================================================
# AHM International — Environment Variables
# Copy this file to `.env.local` and fill in real values before launch.
# Never commit `.env.local`. Secrets must not be exposed to the client.
# Only variables prefixed with NEXT_PUBLIC_ are available in the browser.
# =====================================================================

# --- Site ---------------------------------------------------------------
# Canonical production URL (no trailing slash). Used for metadata, sitemap,
# canonical URLs and Open Graph.
# Canonical host is the APEX domain. www redirects to it permanently
# (see next.config.mjs), so setting www here would fight that redirect.
NEXT_PUBLIC_SITE_URL=https://odoovations.com

# --- Contact / WhatsApp (client-safe) -----------------------------------
# WhatsApp number in international format WITHOUT + or spaces, e.g. 923001234567
NEXT_PUBLIC_WHATSAPP_NUMBER=REPLACE_WITH_REAL_WHATSAPP_NUMBER
# Public discovery-call scheduling link (Calendly / Google / etc). Leave blank
# to hide scheduling CTAs gracefully.
NEXT_PUBLIC_SCHEDULING_URL=

# --- Analytics (optional, client-safe) ----------------------------------
# Leave blank to disable. Plausible domain or GA4 measurement id.
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_GA_ID=

# --- Contact form delivery (server-only) --------------------------------
# The dev adapter validates and logs submissions without sending email.
# To send real email, set a provider below. Resend is supported out of the box.
# If RESEND_API_KEY is empty, the API route runs in dev-adapter mode.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@odoovations.com
CONTACT_FROM_EMAIL=hello@odoovations.com

# --- Spam protection (server-only) --------------------------------------
# Simple shared honeypot + rate limiting are built in and need no config.
# Optional: set a Cloudflare Turnstile secret to enable token verification.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
